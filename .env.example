# WedPlan Client Environment Variables
# Copy to .env.local for local development. Never commit real keys or .env files.

# Better Auth Configuration
# Production example: https://wedplan-client-pearl.vercel.app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Database Configuration
MONGODB_URI=
DB_NAME=wedplan

# Google OAuth Credentials
# Production callback: https://wedplan-client-pearl.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB API Key (Server-side image uploads only)
IMGBB_API_KEY=

# Backend API URL (Express.js server)
# Production example: https://wedplan-server-ruddy.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Client Base URL
# Production example: https://wedplan-client-pearl.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
