# WedPlan Client Environment Variables
# Copy to .env.local for local development. Never commit real keys.

# Backend API URL (Express.js server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Client Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Publishable Key (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample

# ImgBB API Key (Image hosting)
NEXT_PUBLIC_IMGBB_API_KEY=sample_imgbb_key
